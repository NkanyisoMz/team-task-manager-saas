<h1 class="text-3xl font-bold mb-2">
  Dashboard
</h1>

<p class="text-gray-700 mb-8">
  Welcome,
  <strong><%= current_user.email %></strong>
</p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-xl font-semibold mb-4">
      Your Assigned Tasks
    </h2>

    <% if @assigned_tasks.any? %>
      <ul class="space-y-4">
        <% @assigned_tasks.each do |task| %>
          <li class="border-b last:border-b-0 pb-4 last:pb-0">

            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">

              <div>
                <%= link_to task.title,
                    team_project_task_path(
                      task.project.team,
                      task.project,
                      task
                    ),
                    class: "font-semibold text-blue-600 hover:underline" %>

                <p class="text-sm text-gray-500 mt-1">
                  <%= task.project.name %>
                  ·
                  <%= task.project.team.name %>
                </p>

                <div class="mt-3">
                  <span class="inline-flex items-center border rounded-full px-2.5 py-1 text-xs font-medium <%= task_due_date_classes(task) %>">
                    <%= task_due_date_text(task) %>
                  </span>
                </div>
              </div>

              <span class="inline-flex self-start border rounded-full px-3 py-1 text-xs font-medium <%= task.status_classes %>">
                <%= task.status.humanize %>
              </span>

            </div>

          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">
        No assigned tasks yet.
      </p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between gap-4 mb-4">
      <h2 class="text-xl font-semibold">
        Pending Invitations
      </h2>

      <% if @pending_invitations.any? %>
        <%= link_to "View Invitations",
            invitations_path,
            class: "text-sm font-medium text-blue-600 hover:underline" %>
      <% end %>
    </div>

    <% if @pending_invitations.any? %>
      <ul class="space-y-3">
        <% @pending_invitations.each do |invitation| %>
          <li class="border-b last:border-b-0 pb-3 last:pb-0">

            <%= link_to invitations_path,
                class: "block rounded hover:bg-gray-50 p-2 -mx-2 transition" do %>

              <div class="font-medium text-blue-600">
                <%= invitation.team.name %>
              </div>

              <div class="text-sm text-gray-600 mt-1">
                Role:
                <%= invitation.role.humanize %>
              </div>

            <% end %>

          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">
        No pending invitations.
      </p>
    <% end %>
  </div>

</div>

<div class="bg-white rounded-lg shadow p-6 mt-6">
  <div class="flex justify-between items-center mb-4">

    <h2 class="text-xl font-semibold">
      Your Teams
    </h2>

    <%= link_to "Create Team",
        new_team_path,
        class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <% if @teams.any? %>
    <ul class="space-y-3">
      <% @teams.each do |team| %>
        <li class="border-b pb-2">
          <%= link_to team.name,
              team_projects_path(team),
              class: "text-blue-600 hover:underline font-medium" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">
      You are not part of any teams yet.
    </p>
  <% end %>
</div>

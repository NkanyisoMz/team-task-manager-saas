<li id="<%= dom_id(project) %>"
    class="border rounded p-4 hover:bg-gray-50 flex justify-between items-center">

    <%= link_to project.name,
        team_project_path(project.team, project),
        class: "text-xl font-semibold text-blue-600 hover:underline" %>

    <% if @is_admin %>
      <%= button_to "Delete",
          team_project_path(project.team, project),
          method: :delete,
          data: {
            turbo_confirm: "Are you sure you want to delete this project?"
          },
          class: "bg-red-600 text-white px-3 py-2 rounded hover:bg-red-700 text-sm font-medium" %>
    <% end %>

</li>

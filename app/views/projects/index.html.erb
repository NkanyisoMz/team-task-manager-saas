<h1><%= @team.name %> Projects</h1>

<% if current_user.memberships.find_by(team: @team)&.admin? %>
  <%= link_to "New Project", new_team_project_path(@team) %>
<% end %>

<ul>
  <% @projects.each do |project| %>
    <li>
      <%= link_to project.name, team_project_path(@team, project) %>
    </li>
  <% end %>
</ul>
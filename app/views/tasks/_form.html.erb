<%= form_with(model: [@team, @project, @task]) do |form| %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :assignee_id, "Assign To" %>

    <%= form.collection_select(
          :assignee_id,
          @team.users,
          :id,
          :email,
          prompt: "Select team member"
        ) %>
  </div>

  <div>
  <%= form.label :status %>

  <%= form.select :status,
                  Task.statuses.keys.map { |status|
                    [status.humanize, status]
                  } %>
  </div>

  <div>
    <%= form.submit %>
  </div>

<% end %>
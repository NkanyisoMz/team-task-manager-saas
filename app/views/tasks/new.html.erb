<h1>New Task</h1>

<%= form_with model: [@team, @project, @task] do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :status %>
    <%= f.select :status, Task.statuses.keys %>
  </div>

  <div>
    <%= f.label :due_date %>
    <%= f.datetime_select :due_date %>
  </div>

  <div>
    <%= f.submit "Create Task" %>
  </div>
<% end %>
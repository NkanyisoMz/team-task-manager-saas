<% if @saved_task.present? %>
<%= turbo_stream.append "tasks" do %>
  <%= render @saved_task %>
<% end %>


<%= turbo_stream.replace "new_task" do %>

  <%= render "new_task_form" %>

<% end %>

<%= turbo_stream.replace "flash" do %>
  <%= render "shared/flash" %>
<% end %>


<%= turbo_stream.remove "empty_tasks_message" %>

<% else %>

  <%= turbo_stream.replace "new_task" do %>
    <%= render "new_task_form" %>
  <% end %>

  <%= turbo_stream.replace "flash" do %>
  <%= render "shared/flash" %>
<% end %>

<% end %>

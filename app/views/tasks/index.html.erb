<div class="flex justify-between items-center mb-6">

  <h1 class="text-3xl font-bold">
    <%= @project.name %> Tasks
  </h1>

  <% if current_user.memberships.find_by(team: @team)&.admin? %>

    <%= link_to "New Task",
        new_team_project_task_path(@team, @project),
        class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>

  <% end %>

</div>

<div class="bg-white p-4 rounded-lg shadow mb-6">

  <%= form_with url: team_project_tasks_path(@team, @project),
                method: :get,
                local: true,
                class: "flex flex-col md:flex-row gap-4" do |form| %>

    <div class="flex-1">
      <%= form.text_field :query,
          value: params[:query],
          placeholder: "Search tasks...",
          class: "w-full border rounded px-3 py-2" %>
    </div>

    <div>
      <%= form.select :status,
          options_for_select(
            [["All Statuses", ""]] +
            Task.statuses.keys.map { |status|
              [status.humanize, status]
            },
            params[:status]
          ),
          {},
          class: "border rounded px-3 py-2" %>
    </div>

    <div>
      <%= form.submit "Filter",
          class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    </div>

  <% end %>

</div>

<div class="bg-white rounded-lg shadow p-6">

  <% if @tasks.any? %>

    <ul class="space-y-4">

      <% @tasks.each do |task| %>

        <li class="border rounded p-4 hover:bg-gray-50">

          <div class="flex justify-between items-center">

            <div>

              <%= link_to task.title,
                  team_project_task_path(@team, @project, task),
                  class: "text-xl font-semibold text-blue-600 hover:underline" %>

              <p class="text-sm text-gray-600 mt-1">
                Assigned to:
                <%= task.assignee&.email || "Nobody" %>
              </p>

            </div>

            <span class="bg-gray-200 px-3 py-1 rounded text-sm">
              <%= task.status.humanize %>
            </span>

          </div>

        </li>

      <% end %>

    </ul>

  <% else %>

    <p class="text-gray-500">
      No tasks yet.
    </p>

  <% end %>

</div>
<div class="mt-6">
  <p>Total pages: <%= @pagy.pages %></p>

  <p>Total count: <%= @pagy.count %></p>
  <%== pagy_nav(@pagy) %>
</div>
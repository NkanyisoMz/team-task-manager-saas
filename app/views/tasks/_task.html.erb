<%= turbo_frame_tag dom_id(task) do %>
<li class="border rounded p-4 hover:bg-gray-50">

          <div class="flex justify-between items-center">

            <div>

              <%= link_to task.title,
                  team_project_task_path(@team, @project, task),
                  class: "text-xl font-semibold text-blue-600 hover:underline" %>

              <p class="text-sm text-gray-600 mt-1">
                Assigned to:
                <%= task.assignee&.email || "Nobody" %>
              </p>

            </div>

            <div class="flex items-center gap-3">

              <%= form_with model: [@team, @project, task] do |form| %>

                  <%= form.select :status,
                      Task.statuses.keys.map { |status| [status.humanize, status] },
                      {},
                      onchange: "this.form.requestSubmit()",
                      class: "rounded px-2 py-1 text-sm #{task.status_classes}" %>

              <% end %>

            <%= button_to "Delete",
              team_project_task_path(@team, @project, task),
              method: :delete,
              data: {
                turbo_confirm: "Are you sure you want to delete this task?"
              },
              class: "bg-red-600 text-white px-3 py-2 rounded hover:bg-red-700 text-sm font-medium" %>

          </div>

</li>
<% end %>

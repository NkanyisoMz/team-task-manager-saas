<h1><%= @task.title %></h1>

<p>
  <strong>Assigned To:</strong>

  <% if @task.assignee %>
    <%= @task.assignee.email %>
  <% else %>
    Unassigned
  <% end %>
</p>

<p><%= @task.description %></p>
<p>
  <strong>Status:</strong>
  <%= @task.status.humanize %>
</p>
<p>Due: <%= @task.due_date %></p>
<%= link_to "Edit Task",
            edit_team_project_task_path(@team, @project, @task) %>
<%= link_to "View Comments",
    team_project_task_comments_path(@team, @project, @task) %>
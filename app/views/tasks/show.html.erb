<div id="<%= dom_id(@task) %>"
     class="bg-white shadow rounded-lg p-6">

  <div class="flex justify-between items-start mb-6">

    <div>

      <h1 class="text-3xl font-bold mb-2">
        <%= @task.title %>
      </h1>

      <span class="inline-block border rounded-full px-3 py-1 text-sm font-medium <%= @task.status_classes %>">
        <%= @task.status.humanize %>
      </span>

    </div>

  </div>

  <div class="space-y-4 text-gray-700">

    <p>
      <strong>Assigned To:</strong>

      <% if @task.assignee %>
        <%= @task.assignee.email %>
      <% else %>
        Unassigned
      <% end %>
    </p>

    <p>
      <strong>Description:</strong><br>
      <%= @task.description %>
    </p>

    <div>
      <strong class="block mb-2">
        Due Date:
      </strong>

      <span class="inline-block border rounded-full px-3 py-1 text-sm font-medium <%= task_due_date_classes(@task) %>">
        <%= task_due_date_text(@task) %>
      </span>

      <% if @task.due_date.present? %>
        <p class="text-sm text-gray-500 mt-2">
          <%= @task.due_date.to_date.strftime("%A, %d %B %Y") %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="flex gap-4 mt-8">

    <%= link_to "Edit Task",
        edit_team_project_task_path(@team, @project, @task),
        class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>

    <%= link_to "View Comments",
        team_project_task_comments_path(@team, @project, @task),
        class: "bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-800" %>

  </div>

</div>

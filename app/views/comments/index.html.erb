<h1>Comments for: <%= @task.title %></h1>

<%= link_to "Back to Task", team_project_task_path(@team, @project, @task) %>

<hr>

<h3>Add Comment</h3>

<%= form_with model: [@team, @project, @task, @comment] do |f| %>
  <div>
    <%= f.label :content %>
    <%= f.text_area :content %>
  </div>

  <div>
    <%= f.submit "Post Comment" %>
  </div>
<% end %>

<hr>

<h3>All Comments</h3>

<ul>
  <% @comments.each do |comment| %>
    <li>
      <strong><%= comment.user.email %>:</strong>
      <%= comment.content %>
    </li>
  <% end %>
</ul>